PREFIX facepe: <http://gic.ufrpe.br/facepe-inovacao/vocabulary/facepe#>

# Trajetória completa (todos os editais em que coordenaram projetos) dos coordenadores
# do Global.PE Espanha (edital 22/2026): não só o que fizeram nesse edital, mas em quais
# outros editais/programas também aparecem. Mesma estrutura de
# TrajetoriaCoordenadoresTecnovaIII.sparql; a pessoa é identificada por id_pessoa.
SELECT DISTINCT ?nome ?qtdEditais ?programa ?edital
WHERE {
	{
		SELECT ?id (SAMPLE(?nomePessoa) AS ?nome) (COUNT(DISTINCT ?editalInd) AS ?qtdEditais)
		WHERE {
			?coordenador facepe:id_pessoa ?id ;
				facepe:nm_pessoa ?nomePessoa ;
				facepe:coordena ?projeto .
			?projeto facepe:submetido_a ?editalInd .

			FILTER EXISTS {
				?coordenadorGlobal facepe:id_pessoa ?id ;
					facepe:coordena ?projetoGlobal .
				?projetoGlobal facepe:submetido_a ?editalGlobal .
				?editalGlobal facepe:id_edital "22/2026" ;
					facepe:vinculado_a_programa ?programaGlobal .
				?programaGlobal facepe:nm_programa_cti "Global.PE" .
			}
		}
		GROUP BY ?id
	}

	?coordenador facepe:id_pessoa ?id ;
		facepe:coordena ?projeto .
	?projeto facepe:submetido_a ?editalInd .
	?editalInd facepe:id_edital ?edital ;
		facepe:vinculado_a_programa ?programaInd .
	?programaInd facepe:nm_programa_cti ?programa .
}
ORDER BY DESC(?qtdEditais) ?nome ?programa ?edital
